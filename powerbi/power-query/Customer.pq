// Verified snapshot derived from UCI Online Retail II by build/clean_retail.py.
// Fixed historical dataset; regenerate alongside Sales if the source snapshot changes.
let
    Rows = Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.Deflate)),
    Source = Table.FromRows(Rows,{"CustomerKey", "Identified"}),
    Typed = Table.TransformColumnTypes(Source,{{"CustomerKey",type text},{"Identified",type text}},"en-GB")
in
    Typed
